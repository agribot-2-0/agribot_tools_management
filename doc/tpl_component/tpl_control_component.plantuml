@startuml

() "/agribot/control/tool/(front/back)/manual \n AgribotTool.msg" as manual_control_tool
() "/agribot/control/tool/(front/back)/navigation \n AgribotTool.msg" as navi_control_tool
() "/agribot/control/tool/(front/back) \n AgribotTool.msg" as control_tool
() "/agribot/tool_management/control_source \n agribot_msgs/ToolManagerControlSource.srv" as control_source
() "tpl status \n can0_frame" as tpl_status_can0
() "tpl config \n can0_frame" as tpl_config_can0
() "encoder feedback \n can1_frame" as tpl_feedback_can1
() "pto/rgb_valves feedback \n can1_frame" as tpl_valves_feedback_can1
() "tpl valves control \n can1_frame" as tpl_control_can1

  component agribot_commander {
    [State Machine] as statemachine
  }

  component agribot_tool_management
  component agribot_navigation

'

  () "agribot/inclinometer\n sensor_msgs::Imu.msg" as hal_inclinometer_topic


  component hal_agribot_control {
    () "\n /agribot/control/tool/(front/back)/valves" as control_valves
    () "/agribot/encoder/tool/(front/back) \n AgribotTool.msg" as tool_tpl_status

    [hal_tpl_status] as tpl_status
    [hal_tpl_controller] as tpl_controller

    tpl_controller -( tool_tpl_status
    tool_tpl_status - tpl_status
    [TTC communication] as ttc_communication

    ttc_communication -( control_valves
    control_valves - tpl_controller
  }

  tpl_status -( hal_inclinometer_topic
  hal_inclinometer_topic - [hal_inclinometer]
  component hal_inclinometer
  component hal_mobile_app



  component Encoder
  component TTControl
  component MobileApp

statemachine -- control_source 

control_source )-- [agribot_tool_management] 

[agribot_navigation] - navi_control_tool
navi_control_tool )- [agribot_tool_management]

agribot_tool_management --( manual_control_tool
agribot_tool_management -- control_tool


control_tool )-- tpl_controller

manual_control_tool -- [hal_mobile_app]



tpl_config_can0 -- MobileApp

[hal_mobile_app] -- tpl_status_can0 
tpl_status_can0 )-- MobileApp

[hal_mobile_app] --( tpl_config_can0
[hal_mobile_app] -( tool_tpl_status

tpl_status --( tpl_feedback_can1
tpl_feedback_can1 -- Encoder

tpl_status --( tpl_valves_feedback_can1
tpl_valves_feedback_can1 -- TTControl

ttc_communication -- tpl_control_can1
tpl_control_can1 )-- TTControl

@enduml